{
  "name": "plotforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/creator-desktop",
    "apps/player-web"
  ],
  "scripts": {
    "creator-desktop:dev": "npm run dev --workspace @plotforge/creator-desktop",
    "creator-desktop:typecheck": "npm run typecheck --workspace @plotforge/creator-desktop",
    "creator-desktop:test": "npm run test --workspace @plotforge/creator-desktop",
    "creator-desktop:build": "npm run build --workspace @plotforge/creator-desktop",
    "creator-desktop:tauri:check": "npm run tauri:check --workspace @plotforge/creator-desktop",
    "creator-desktop:tauri:dev": "npm run tauri:dev --workspace @plotforge/creator-desktop",
    "creator-desktop:tauri:build": "npm run tauri:build --workspace @plotforge/creator-desktop",
    "creator-desktop:smoke": "python3 scripts/qa/creator_desktop_build_smoke.py",
    "creator-desktop:qa": "npm run creator-desktop:typecheck && npm run creator-desktop:test && npm run creator-desktop:build && npm run creator-desktop:smoke && npm run creator-desktop:tauri:check",
    "player-web:test": "npm run test --workspace @plotforge/player-web",
    "player-web:qa": "npm run player-web:test",
    "frontend:qa": "npm run creator-desktop:qa && npm run player-web:qa"
  }
}
